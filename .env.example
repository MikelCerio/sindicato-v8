# Sindicato V8 ELITE - Environment Variables
# Copia este archivo a .env y rellena con tus API keys

# OpenAI API Key (REQUERIDO)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Opcional: OpenBB Personal Access Token
# Solo necesario para datos premium
# Obtener en: https://my.openbb.co/
# OPENBB_PAT=your-openbb-pat-here

# Copiloto / informes (research/)
# La SEC exige un User-Agent con un email de contacto para su API pública
SEC_USER_AGENT="Sindicato V8 tu-email@ejemplo.com"
# Modelos (opcional)
# COPILOT_MODEL=gpt-4o
# REPORT_MODEL=gpt-4o
